# ---------------------------------------------------------------------------
# restart.env  — per-project overrides for restart_server.bat / restart_server.py
# Copy this file to `restart.env` in your Django project root and edit as needed.
# ---------------------------------------------------------------------------

# Django manage.py location (relative to project root)
set MANAGE_PY=manage.py

# Virtualenv directory name (venv, .venv, env, etc.)
set VENV_DIR=venv

# Dev server bind address and port
set BIND_ADDR=0.0.0.0
set PROJECT_PORT=8000

# Automatically pip install -r requirements.txt before starting?
set AUTO_INSTALL=1

# Run `manage.py check` before starting (blocks restart on failure)?
set RUN_CHECK=1

# Open the browser automatically after the server starts?
set OPEN_BROWSER=0

# ---------------------------------------------------------------------------
# Usage (Windows):
#   restart_server.bat          # uses restart.env if present
#
# Usage (Python / cross-platform):
#   python restart_server.py
#   python restart_server.py --port 8000 --no-install --no-check
# ---------------------------------------------------------------------------
